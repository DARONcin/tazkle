# Copia este archivo como infrastructure/.env.local.
# Usa un valor aleatorio sólo para tu entorno local; no lo confirmes en Git.
TAZKLE_POSTGRES_ADMIN_PASSWORD=replace-with-a-random-admin-password
TAZKLE_APP_DATABASE_PASSWORD=replace-with-a-different-random-app-password
TAZKLE_IDENTITY_DATABASE_PASSWORD=replace-with-a-third-random-database-password
TAZKLE_INTERNAL_IDENTITY_SECRET=replace-with-at-least-32-random-bytes
TAZKLE_BETTER_AUTH_SECRET=replace-with-an-independent-random-auth-secret
# Correo transaccional para verificación y segundo factor.
TAZKLE_RESEND_API_KEY=replace-with-a-resend-sending-access-key
TAZKLE_AUTH_EMAIL_FROM=Tazkle <onboarding@resend.dev>
# Desarrollo local: Better Auth se publica solamente a través de Gateway.
TAZKLE_BETTER_AUTH_URL=http://127.0.0.1:8787/api/auth
TAZKLE_OIDC_ISSUER=http://127.0.0.1:8787/api/auth
TAZKLE_OIDC_AUDIENCE=tazkle-local
TAZKLE_OIDC_JWKS_URL=http://identity:8791/api/auth/jwks
TAZKLE_ALLOW_INSECURE_LOCAL_OIDC=true
# Identificador público del cliente nativo. Nunca agregues un client secret.
TAZKLE_OIDC_CLIENT_ID=tazkle-macos
# Recurso OAuth opcional que hace que el access token se emita para Gateway.
TAZKLE_OIDC_RESOURCE=tazkle-local
# Providers sociales opcionales. Déjalos vacíos para ocultar sus botones.
# Registra los callbacks:
# http://127.0.0.1:8787/api/auth/callback/google
# http://127.0.0.1:8787/api/auth/callback/microsoft
TAZKLE_GOOGLE_CLIENT_ID=
TAZKLE_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
TAZKLE_MICROSOFT_CLIENT_ID=
TAZKLE_MICROSOFT_CLIENT_SECRET=replace-with-microsoft-oauth-client-secret
# "common" admite cuentas Microsoft personales y organizacionales.
TAZKLE_MICROSOFT_TENANT_ID=common
TAZKLE_GATEWAY_PORT=8787
